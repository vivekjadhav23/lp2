#include <iostream>
#include <vector>

using namespace std;

int N = 4;

bool isSafe(vector<vector<int>>& board,
            int row,
            int col) {

    // Check upper column
    for (int i = 0; i < row; i++) {
        if (board[i][col])
            return false;
    }

    // Check upper left diagonal
    for (int i = row - 1, j = col - 1;
         i >= 0 && j >= 0;
         i--, j--) {

        if (board[i][j])
            return false;
    }

    // Check upper right diagonal
    for (int i = row - 1, j = col + 1;
         i >= 0 && j < N;
         i--, j++) {

        if (board[i][j])
            return false;
    }

    return true;
}

bool solveNQueen(vector<vector<int>>& board,
                 int row) {

    if (row == N)
        return true;

    for (int col = 0; col < N; col++) {

        if (isSafe(board, row, col)) {

            board[row][col] = 1;

            if (solveNQueen(board, row + 1))
                return true;

            // Backtrack
            board[row][col] = 0;
        }
    }

    return false;
}

void printBoard(vector<vector<int>>& board) {

    for (int i = 0; i < N; i++) {

        for (int j = 0; j < N; j++) {

            if (board[i][j])
                cout << "Q ";
            else
                cout << ". ";
        }

        cout << endl;
    }
}

int main() {

    vector<vector<int>> board(N,
                              vector<int>(N, 0));

    if (solveNQueen(board, 0)) {

        cout << "Solution Found:\n";

        printBoard(board);

    } else {

        cout << "No Solution Exists";
    }

    return 0;
}
